;; ============================================================
;; Kanata config converted from vial.json
;; Minimal defsrc preserved; Colemak-DH remains software-mapped.
;;
;; Vial layer 0 -> base
;; Vial layer 1 -> numbers
;; Vial layer 2 -> custom
;; Vial layer 3 -> qwerty
;;
;; Notes:
;; - The minimal defsrc omits many physical keys present in Vial,
;;   so those keys cannot be represented here.
;; - USER00–USER11 actions are unknown; XX is used as requested.
;; - Vial-specific RGB/macro controls are not reproduced.
;; ============================================================

(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  danger-enable-cmd yes
  concurrent-tap-hold yes
)

(defsrc
  esc q w e r t y u i o p
  caps a s d f g h j k l ;
  z x c v b n m , . /
  spc
  lalt
  left right up down
)

(defvar
  tap-time 150
  hold-time 180
)

(defalias
  ;; Colemak-DH home-row mods, matching Vial layer 0
  a (tap-hold $tap-time $hold-time a lmet)
  s (tap-hold $tap-time $hold-time r lctl)
  d (tap-hold $tap-time $hold-time s lsft)
  f (tap-hold $tap-time $hold-time t lalt)
  j (tap-hold $tap-time $hold-time n ralt)
  k (tap-hold $tap-time $hold-time e rsft)
  l (tap-hold $tap-time $hold-time i rctl)
  ; (tap-hold $tap-time $hold-time o rmet)

  spc (tap-hold $tap-time $hold-time spc (layer-while-held numbers))
  ralt (tap-hold $tap-time $hold-time ralt (layer-toggle arrows))

  caps_escape esc
  caps_tab tab

  vim-left left
  vim-down down
  vim-up up
  vim-right right

  n1 1 n2 2 n3 3 n4 4 n5 5 n6 6 n7 7 n8 8 n9 9 n0 0
  s1 (multi lsft 1) s2 (multi lsft 2) s3 (multi lsft 3) s4 (multi lsft 4)
  s5 (multi lsft 5) s6 (multi lsft 6) s7 (multi lsft 7) s8 (multi lsft 8)
  s9 (multi lsft 9) s0 (multi lsft 0)
)

;; Vial layer 0: Colemak-DH + home-row mods
(deflayer base
  esc  q    w    f    p    b    j    l    u    y    ;
  @caps_escape @a @s @d @f  g    m    @j   @k   @l   @;
  z    x    c    d    v    k    h    ,    .    /
  @spc
  @ralt
  left right up down
)

;; Vial layer 1: number row, symbols, and navigation.
;; Only keys represented in the minimal defsrc are mapped.
(deflayer numbers
  esc  @n1  @n2  @n3  @n4  @n5  @n6  @n7  @n8  @n9  @n0
  @caps_escape lmet lctl lsft lalt prtsc left down up right ;
  z    x    c    d    v    k    h    ,    .    /
  @spc
  @ralt
  left right up down
)

;; Vial layer 2: custom/user layer.
;; Unknown USER00–USER11 actions are represented by XX.
(deflayer custom
  esc  XX   XX   XX   XX   XX   y    u    prtsc XX pause
  caps  w    XX   XX   XX   XX   XX   j    k    l    XX
  z    XX   XX   v    b    n    m    ,    .    /
  @spc
  @ralt
  left right up down
)

;; Vial layer 3: standard QWERTY layer.
(deflayer qwerty
  esc  q    w    e    r    t    y    u    i    o    p
  caps a s d f g h j k l ;
  z    x    c    v    b    n    m    ,    .    /
  spc
  lalt
  left right up down
)

;; Optional arrows layer retained from your original config.
;; This is a custom Kanata layer, not a separate Vial layer.
(deflayer arrows
  XX   q    w    f    p    b    j    l    u    y    ;
  @caps_escape @a @s @d @f  g    @vim-left @vim-down @vim-up @vim-right o
  z    x    c    d    v    k    h    ,    .    /
  @spc
  @ralt
  left right up down
)
