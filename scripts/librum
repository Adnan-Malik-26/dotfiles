gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')

# Try WebKit 6.0 first, fallback to 4.1
try:
    gi.require_version('WebKit', '6.0')
except ValueError:
    try:
        gi.require_version('WebKit', '4.1')
    except ValueError:
        print("Warning: WebKit not available. EPUB support will be limited.")
        WebKit = None

from gi.repository import Gtk, Adw, Gio, GLib, Gdk

if WebKit is None:
    try:
        from gi.repository import WebKit
    except (ImportError, ValueError):
        WebKit = None

import sqlite3
import json
import os
import hashlib
from pathlib import Path
from datetime import datetime
from dataclasses import dataclass, asdict
from typing import Optional, List, Dict, Any
import ebooklib
from ebooklib import epub
from bs4 import BeautifulSoup
import fitz  # PyMuPDF for PDF/MOBI


# ==================== DATA MODELS ====================

@dataclass
class Book:
    """Book metadata model"""
    id: Optional[int] = None
    file_path: str = ""
    title: str = "Unknown"
    author: str = "Unknown"
    format: str = ""
    cover_path: Optional[str] = None
    current_page: int = 0
    total_pages: int = 0
    last_opened: Optional[str] = None
    date_added: Optional[str] = None
    file_hash: str = ""


@dataclass
class Bookmark:
    """Bookmark model"""
    id: Optional[int] = None
    book_id: int = 0
    page: int = 0
    title: str = ""
    created_at: Optional[str] = None


@dataclass
class Highlight:
    """Highlight model"""
    id: Optional[int] = None
    book_id: int = 0
    page: int = 0
    text: str = ""
    color: str = "#FFFF00"
    note: str = ""
    created_at: Optional[str] = None


# ==================== DATABASE MANAGER ====================

class DatabaseManager:
    """Manages SQLite database for library and user data"""
    
    def __init__(self, db_path: str):
        self.db_path = db_path
        self.conn = None
        self.init_database()
    
    def init_database(self):
        """Initialize database with required tables"""
        self.conn = sqlite3.connect(self.db_path)
        self.conn.row_factory = sqlite3.Row
        cursor = self.conn.cursor()
        
        # Books table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS books (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                file_path TEXT UNIQUE NOT NULL,
                title TEXT NOT NULL,
                author TEXT,
                format TEXT,
                cover_path TEXT,
                current_page INTEGER DEFAULT 0,
                total_pages INTEGER DEFAULT 0,
                last_opened TIMESTAMP,
                date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                file_hash TEXT UNIQUE
            )
        ''')
        
        # Bookmarks table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS bookmarks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                book_id INTEGER NOT NULL,
                page INTEGER NOT NULL,
                title TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (book_id) REFERENCES books (id) ON DELETE CASCADE
            )
        ''')
        
        # Highlights table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS highlights (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                book_id INTEGER NOT NULL,
                page INTEGER NOT NULL,
                text TEXT,
                color TEXT DEFAULT '#FFFF00',
                note TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (book_id) REFERENCES books (id) ON DELETE CASCADE
            )
        ''')
        
        # Settings table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS settings (
                key TEXT PRIMARY KEY,
                value TEXT
            )
        ''')
        
        self.conn.commit()
    
    def add_book(self, book: Book) -> int:
        """Add a book to the library"""
        cursor = self.conn.cursor()
        cursor.execute('''
            INSERT INTO books (file_path, title, author, format, cover_path, 
                             total_pages, file_hash)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        ''', (book.file_path, book.title, book.author, book.format,
              book.cover_path, book.total_pages, book.file_hash))
        self.conn.commit()
        return cursor.lastrowid
    
    def get_all_books(self) -> List[Book]:
        """Retrieve all books from library"""
        cursor = self.conn.cursor()
        cursor.execute('SELECT * FROM books ORDER BY last_opened DESC, date_added DESC')
        rows = cursor.fetchall()
        return [Book(**dict(row)) for row in rows]
    
    def get_book(self, book_id: int) -> Optional[Book]:
        """Get a specific book by ID"""
        cursor = self.conn.cursor()
        cursor.execute('SELECT * FROM books WHERE id = ?', (book_id,))
        row = cursor.fetchone()
        return Book(**dict(row)) if row else None
    
    def update_book_position(self, book_id: int, page: int):
        """Update current reading position"""
        cursor = self.conn.cursor()
        cursor.execute('''
            UPDATE books 
            SET current_page = ?, last_opened = CURRENT_TIMESTAMP 
            WHERE id = ?
        ''', (page, book_id))
        self.conn.commit()
    
    def add_bookmark(self, bookmark: Bookmark) -> int:
        """Add a bookmark"""
        cursor = self.conn.cursor()
        cursor.execute('''
            INSERT INTO bookmarks (book_id, page, title)
            VALUES (?, ?, ?)
        ''', (bookmark.book_id, bookmark.page, bookmark.title))
        self.conn.commit()
        return cursor.lastrowid
    
    def get_bookmarks(self, book_id: int) -> List[Bookmark]:
        """Get all bookmarks for a book"""
        cursor = self.conn.cursor()
        cursor.execute('SELECT * FROM bookmarks WHERE book_id = ? ORDER BY page', 
                      (book_id,))
        rows = cursor.fetchall()
        return [Bookmark(**dict(row)) for row in rows]
    
    def delete_bookmark(self, bookmark_id: int):
        """Delete a bookmark"""
        cursor = self.conn.cursor()
        cursor.execute('DELETE FROM bookmarks WHERE id = ?', (bookmark_id,))
        self.conn.commit()
    
    def get_setting(self, key: str, default: str = "") -> str:
        """Get a setting value"""
        cursor = self.conn.cursor()
        cursor.execute('SELECT value FROM settings WHERE key = ?', (key,))
        row = cursor.fetchone()
        return row[0] if row else default
    
    def set_setting(self, key: str, value: str):
        """Set a setting value"""
        cursor = self.conn.cursor()
        cursor.execute('''
            INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)
        ''', (key, value))
        self.conn.commit()


# ==================== BOOK PARSERS ====================

class BookParser:
    """Base class for book parsers"""
    
    @staticmethod
    def get_file_hash(file_path: str) -> str:
        """Generate hash for file"""
        hasher = hashlib.sha256()
        with open(file_path, 'rb') as f:
            for chunk in iter(lambda: f.read(8192), b''):
                hasher.update(chunk)
        return hasher.hexdigest()
    
    @staticmethod
    def parse_book(file_path: str) -> Optional[Book]:
        """Parse book and extract metadata"""
        ext = Path(file_path).suffix.lower()
        
        if ext == '.epub':
            return EPUBParser.parse(file_path)
        elif ext in ['.pdf', '.mobi']:
            return PDFParser.parse(file_path)
        
        return None


class EPUBParser:
    """EPUB file parser"""
    
    @staticmethod
    def parse(file_path: str) -> Optional[Book]:
        try:
            book_epub = epub.read_epub(file_path)
            
            title = book_epub.get_metadata('DC', 'title')
            title = title[0][0] if title else Path(file_path).stem
            
            author = book_epub.get_metadata('DC', 'creator')
            author = author[0][0] if author else "Unknown"
            
            # Count pages (approximate from spine items)
            pages = len(list(book_epub.get_items_of_type(ebooklib.ITEM_DOCUMENT)))
            
            # Extract cover
            cover_path = None
            for item in book_epub.get_items():
                if item.get_type() == ebooklib.ITEM_COVER:
                    cover_path = EPUBParser._save_cover(item, file_path)
                    break
            
            return Book(
                file_path=file_path,
                title=title,
                author=author,
                format='EPUB',
                total_pages=pages,
                cover_path=cover_path,
                file_hash=BookParser.get_file_hash(file_path)
            )
        except Exception as e:
            print(f"Error parsing EPUB: {e}")
            return None
    
    @staticmethod
    def _save_cover(cover_item, book_path: str) -> str:
        """Save cover image to cache"""
        cache_dir = Path.home() / '.cache' / 'librum' / 'covers'
        cache_dir.mkdir(parents=True, exist_ok=True)
        
        file_hash = hashlib.md5(book_path.encode()).hexdigest()
        cover_path = cache_dir / f"{file_hash}.jpg"
        
        with open(cover_path, 'wb') as f:
            f.write(cover_item.get_content())
        
        return str(cover_path)


class PDFParser:
    """PDF/MOBI parser using PyMuPDF"""
    
    @staticmethod
    def parse(file_path: str) -> Optional[Book]:
        try:
            doc = fitz.open(file_path)
            metadata = doc.metadata
            
            title = metadata.get('title', Path(file_path).stem)
            author = metadata.get('author', 'Unknown')
            pages = len(doc)
            
            # Extract cover (first page)
            cover_path = PDFParser._extract_cover(doc, file_path)
            
            doc.close()
            
            ext = Path(file_path).suffix.upper()[1:]
            
            return Book(
                file_path=file_path,
                title=title,
                author=author,
                format=ext,
                total_pages=pages,
                cover_path=cover_path,
                file_hash=BookParser.get_file_hash(file_path)
            )
        except Exception as e:
            print(f"Error parsing PDF/MOBI: {e}")
            return None
    
    @staticmethod
    def _extract_cover(doc, book_path: str) -> Optional[str]:
        """Extract first page as cover"""
        try:
            cache_dir = Path.home() / '.cache' / 'librum' / 'covers'
            cache_dir.mkdir(parents=True, exist_ok=True)
            
            file_hash = hashlib.md5(book_path.encode()).hexdigest()
            cover_path = cache_dir / f"{file_hash}.png"
            
            page = doc[0]
            pix = page.get_pixmap(matrix=fitz.Matrix(0.5, 0.5))
            pix.save(str(cover_path))
            
            return str(cover_path)
        except:
            return None


# ==================== READER WIDGETS ====================

class PDFReaderWidget(Gtk.ScrolledWindow):
    """PDF Reader widget using PyMuPDF"""
    
    def __init__(self):
        super().__init__()
        self.set_vexpand(True)
        self.set_hexpand(True)
        
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_child(self.box)
        
        self.doc = None
        self.current_page = 0
        self.zoom = 1.0
        self.page_images = []
    
    def load_document(self, file_path: str, page: int = 0):
        """Load PDF document"""
        try:
            self.doc = fitz.open(file_path)
            self.current_page = page
            self.render_pages()
        except Exception as e:
            print(f"Error loading PDF: {e}")
    
    def render_pages(self):
        """Render all pages"""
        # Clear existing pages
        while self.box.get_first_child():
            self.box.remove(self.box.get_first_child())
        
        self.page_images = []
        
        if not self.doc:
            return
        
        for page_num in range(len(self.doc)):
            page = self.doc[page_num]
            mat = fitz.Matrix(self.zoom, self.zoom)
            pix = page.get_pixmap(matrix=mat)
            
            # Save to temporary file and load as texture
            import tempfile
            with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tmp:
                pix.save(tmp.name)
                texture = Gdk.Texture.new_from_filename(tmp.name)
                os.unlink(tmp.name)
            picture = Gtk.Picture.new_for_paintable(texture)
            picture.set_can_shrink(False)
            
            self.box.append(picture)
            self.page_images.append(picture)
    
    def goto_page(self, page: int):
        """Navigate to specific page"""
        if 0 <= page < len(self.page_images):
            self.current_page = page
            # Scroll to page
            adj = self.get_vadjustment()
            if self.page_images:
                # Calculate approximate position
                page_height = adj.get_upper() / len(self.page_images)
                adj.set_value(page * page_height)
    
    def next_page(self):
        """Go to next page"""
        if self.current_page < len(self.page_images) - 1:
            self.goto_page(self.current_page + 1)
    
    def prev_page(self):
        """Go to previous page"""
        if self.current_page > 0:
            self.goto_page(self.current_page - 1)
    
    def zoom_in(self):
        """Increase zoom level"""
        self.zoom *= 1.2
        self.render_pages()
    
    def zoom_out(self):
        """Decrease zoom level"""
        self.zoom *= 0.8
        self.render_pages()


class EPUBReaderWidget(Gtk.Box):
    """EPUB Reader widget using WebKitGTK"""
    
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        
        if WebKit is None:
            # Fallback: Show error message
            error_label = Gtk.Label(
                label="WebKit not available.\nEPUB support requires WebKit2GTK 4.1 or 6.0.\n\nInstall with: sudo pacman -S webkit2gtk-4.1"
            )
            error_label.set_valign(Gtk.Align.CENTER)
            error_label.add_css_class("dim-label")
            error_label.add_css_class("title-3")
            self.append(error_label)
            self.webview = None
            return
        
        self.webview = WebKit.WebView()
        self.webview.set_vexpand(True)
        self.webview.set_hexpand(True)
        
        # Enable developer extras for debugging
        settings = self.webview.get_settings()
        settings.set_enable_developer_extras(True)
        settings.set_enable_javascript(True)
        
        self.append(self.webview)
        
        self.epub_book = None
        self.chapters = []
        self.current_chapter = 0
    
    def load_document(self, file_path: str, chapter: int = 0):
        """Load EPUB document"""
        if self.webview is None:
            return
            
        try:
            self.epub_book = epub.read_epub(file_path)
            self.chapters = list(self.epub_book.get_items_of_type(ebooklib.ITEM_DOCUMENT))
            self.current_chapter = chapter
            self.render_chapter()
        except Exception as e:
            print(f"Error loading EPUB: {e}")
    
    def render_chapter(self):
        """Render current chapter"""
        if self.webview is None or not self.chapters or self.current_chapter >= len(self.chapters):
            return
        
        chapter = self.chapters[self.current_chapter]
        content = chapter.get_content().decode('utf-8')
        
        # Wrap in HTML template with styling
        html = f"""
        <!DOCTYPE html>
        <html>
        <head>
            <meta charset="UTF-8">
            <style>
                body {{
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                    font-size: 18px;
                    line-height: 1.6;
                    max-width: 800px;
                    margin: 40px auto;
                    padding: 0 20px;
                    color: #2e3436;
                    background: #ffffff;
                }}
                p {{ margin: 1em 0; }}
                h1, h2, h3 {{ margin-top: 1.5em; }}
                img {{ max-width: 100%; height: auto; }}
            </style>
        </head>
        <body>
            {content}
        </body>
        </html>
        """
        
        self.webview.load_html(html, "file:///")
    
    def next_chapter(self):
        """Go to next chapter"""
        if self.current_chapter < len(self.chapters) - 1:
            self.current_chapter += 1
            self.render_chapter()
    
    def prev_chapter(self):
        """Go to previous chapter"""
        if self.current_chapter > 0:
            self.current_chapter -= 1
            self.render_chapter()
    
    def goto_chapter(self, chapter: int):
        """Navigate to specific chapter"""
        if 0 <= chapter < len(self.chapters):
            self.current_chapter = chapter
            self.render_chapter()


# ==================== LIBRARY VIEW ====================

class LibraryRow(Gtk.Box):
    """Custom row for library list"""
    
    def __init__(self, book: Book):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.book = book
        self.set_margin_start(12)
        self.set_margin_end(12)
        self.set_margin_top(6)
        self.set_margin_bottom(6)
        
        # Cover image
        if book.cover_path and os.path.exists(book.cover_path):
            texture = Gdk.Texture.new_from_filename(book.cover_path)
            cover = Gtk.Picture.new_for_paintable(texture)
            cover.set_size_request(60, 80)
            cover.set_can_shrink(True)
        else:
            cover = Gtk.Label(label="📖")
            cover.set_size_request(60, 80)
            cover.add_css_class("dim-label")
        
        self.append(cover)
        
        # Book info
        info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        info_box.set_valign(Gtk.Align.CENTER)
        
        title_label = Gtk.Label(label=book.title)
        title_label.set_xalign(0)
        title_label.set_ellipsize(3)  # ELLIPSIZE_END
        title_label.add_css_class("title-4")
        
        author_label = Gtk.Label(label=book.author)
        author_label.set_xalign(0)
        author_label.add_css_class("dim-label")
        
        progress_label = Gtk.Label(
            label=f"{book.current_page}/{book.total_pages} • {book.format}"
        )
        progress_label.set_xalign(0)
        progress_label.add_css_class("caption")
        progress_label.add_css_class("dim-label")
        
        info_box.append(title_label)
        info_box.append(author_label)
        info_box.append(progress_label)
        
        self.append(info_box)


class LibraryView(Gtk.ScrolledWindow):
    """Library view showing all books"""
    
    def __init__(self, db: DatabaseManager, on_book_selected):
        super().__init__()
        self.db = db
        self.on_book_selected = on_book_selected
        
        self.list_box = Gtk.ListBox()
        self.list_box.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.list_box.add_css_class("boxed-list")
        self.list_box.connect("row-activated", self._on_row_activated)
        
        self.set_child(self.list_box)
        self.set_vexpand(True)
        
        self.refresh()
    
    def refresh(self):
        """Refresh library list"""
        # Clear existing rows
        while self.list_box.get_first_child():
            self.list_box.remove(self.list_box.get_first_child())
        
        books = self.db.get_all_books()
        
        if not books:
            empty_label = Gtk.Label(label="No books in library\nClick + to add books")
            empty_label.set_valign(Gtk.Align.CENTER)
            empty_label.add_css_class("dim-label")
            empty_label.add_css_class("title-2")
            self.list_box.append(empty_label)
        else:
            for book in books:
                row = LibraryRow(book)
                self.list_box.append(row)
    
    def _on_row_activated(self, list_box, row):
        """Handle book selection"""
        child = row.get_child()
        if isinstance(child, LibraryRow):
            self.on_book_selected(child.book)


# ==================== MAIN WINDOW ====================

class LibrumWindow(Adw.ApplicationWindow):
    """Main application window"""
    
    def __init__(self, app):
        super().__init__(application=app)
        self.set_default_size(1200, 800)
        self.set_title("Librum")
        
        # Initialize database
        config_dir = Path.home() / '.config' / 'librum'
        config_dir.mkdir(parents=True, exist_ok=True)
        self.db = DatabaseManager(str(config_dir / 'library.db'))
        
        self.current_book = None
        self.reader_widget = None
        
        # Setup UI
        self._setup_ui()
        self._setup_actions()
        self._setup_shortcuts()
    
    def _setup_ui(self):
        """Setup main UI"""
        # Main overlay split view
        self.split_view = Adw.OverlaySplitView()
        self.split_view.set_show_sidebar(True)
        self.split_view.set_sidebar_position(Gtk.PackType.START)
        
        # Sidebar
        sidebar_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        
        sidebar_header = Adw.HeaderBar()
        sidebar_header.set_show_end_title_buttons(False)
        
        add_button = Gtk.Button(icon_name="list-add-symbolic")
        add_button.set_tooltip_text("Add Book")
        add_button.connect("clicked", self._on_add_book)
        sidebar_header.pack_start(add_button)
        
        sidebar_box.append(sidebar_header)
        
        self.library_view = LibraryView(self.db, self._on_book_selected)
        sidebar_box.append(self.library_view)
        
        self.split_view.set_sidebar(sidebar_box)
        
        # Content area
        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        
        self.header = Adw.HeaderBar()
        self.header.set_show_start_title_buttons(False)
        
        # Back button
        back_button = Gtk.Button(icon_name="go-previous-symbolic")
        back_button.set_tooltip_text("Library (Esc)")
        back_button.connect("clicked", lambda b: self._show_library())
        self.header.pack_start(back_button)
        
        # Navigation buttons
        prev_button = Gtk.Button(icon_name="go-previous-symbolic")
        prev_button.set_tooltip_text("Previous Page (←)")
        prev_button.connect("clicked", lambda b: self._prev_page())
        self.header.pack_start(prev_button)
        
        next_button = Gtk.Button(icon_name="go-next-symbolic")
        next_button.set_tooltip_text("Next Page (→)")
        next_button.connect("clicked", lambda b: self._next_page())
        self.header.pack_start(next_button)
        
        # Search button
        search_button = Gtk.Button(icon_name="edit-find-symbolic")
        search_button.set_tooltip_text("Search (Ctrl+F)")
        self.header.pack_end(search_button)
        
        # Bookmarks button
        bookmark_button = Gtk.Button(icon_name="bookmark-new-symbolic")
        bookmark_button.set_tooltip_text("Bookmarks (Ctrl+B)")
        self.header.pack_end(bookmark_button)
        
        # TOC button
        toc_button = Gtk.Button(icon_name="view-list-symbolic")
        toc_button.set_tooltip_text("Table of Contents (Ctrl+T)")
        self.header.pack_end(toc_button)
        
        content_box.append(self.header)
        
        # Reader area (placeholder)
        self.reader_stack = Gtk.Stack()
        self.reader_stack.set_vexpand(True)
        
        welcome = Adw.StatusPage()
        welcome.set_title("Welcome to Librum")
        welcome.set_description("Select a book from the library or add new books")
        welcome.set_icon_name("book-symbolic")
        
        self.reader_stack.add_named(welcome, "welcome")
        
        content_box.append(self.reader_stack)
        
        self.split_view.set_content(content_box)
        
        self.set_content(self.split_view)
    
    def _setup_actions(self):
        """Setup application actions"""
        action = Gio.SimpleAction.new("add-book", None)
        action.connect("activate", lambda a, p: self._on_add_book(None))
        self.add_action(action)
        
        action = Gio.SimpleAction.new("prev-page", None)
        action.connect("activate", lambda a, p: self._prev_page())
        self.add_action(action)
        
        action = Gio.SimpleAction.new("next-page", None)
        action.connect("activate", lambda a, p: self._next_page())
        self.add_action(action)
        
        action = Gio.SimpleAction.new("show-library", None)
        action.connect("activate", lambda a, p: self._show_library())
        self.add_action(action)
    
    def _setup_shortcuts(self):
        """Setup keyboard shortcuts"""
        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", self._on_key_pressed)
        self.add_controller(controller)
    
    def _on_key_pressed(self, controller, keyval, keycode, state):
        """Handle keyboard shortcuts"""
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        
        if keyval == Gdk.KEY_Right or keyval == Gdk.KEY_Page_Down:
            self._next_page()
            return True
        elif keyval == Gdk.KEY_Left or keyval == Gdk.KEY_Page_Up:
            self._prev_page()
            return True
        elif keyval == Gdk.KEY_Escape:
            self._show_library()
            return True
        elif ctrl and keyval == Gdk.KEY_f:
            print("Search triggered")
            return True
        elif ctrl and keyval == Gdk.KEY_b:
            print("Bookmarks triggered")
            return True
        elif ctrl and keyval == Gdk.KEY_t:
            print("TOC triggered")
            return True
        
        return False
    
    def _on_add_book(self, button):
        """Open file picker to add books"""
        dialog = Gtk.FileDialog()
        
        # File filters
        epub_filter = Gtk.FileFilter()
        epub_filter.set_name("EPUB files")
        epub_filter.add_pattern("*.epub")
        
        pdf_filter = Gtk.FileFilter()
        pdf_filter.set_name("PDF files")
        pdf_filter.add_pattern("*.pdf")
        
        mobi_filter = Gtk.FileFilter()
        mobi_filter.set_name("MOBI files")
        mobi_filter.add_pattern("*.mobi")
        
        all_filter = Gtk.FileFilter()
        all_filter.set_name("All ebook files")
        all_filter.add_pattern("*.epub")
        all_filter.add_pattern("*.pdf")
        all_filter.add_pattern("*.mobi")
        
        filter_list = Gio.ListStore.new(Gtk.FileFilter)
        filter_list.append(all_filter)
        filter_list.append(epub_filter)
        filter_list.append(pdf_filter)
        filter_list.append(mobi_filter)
        
        dialog.set_filters(filter_list)
        dialog.open(self, None, self._on_file_selected)
    
    def _on_file_selected(self, dialog, result):
        """Handle file selection"""
        try:
            file = dialog.open_finish(result)
            if file:
                file_path = file.get_path()
                book = BookParser.parse_book(file_path)
                
                if book:
                    book.id = self.db.add_book(book)
                    self.library_view.refresh()
                    
                    # Show success toast
                    toast = Adw.Toast.new(f"Added: {book.title}")
                    toast.set_timeout(2)
                    # Note: Toast overlay would need to be added to window
        except Exception as e:
            print(f"Error adding book: {e}")
    
    def _on_book_selected(self, book: Book):
        """Handle book selection from library"""
        self.current_book = book
        self._load_reader()
    
    def _load_reader(self):
        """Load appropriate reader for current book"""
        if not self.current_book:
            return
        
        # Remove old reader if exists
        if self.reader_widget:
            self.reader_stack.remove(self.reader_widget)
            self.reader_widget = None
        
        # Create appropriate reader
        if self.current_book.format == 'EPUB':
            self.reader_widget = EPUBReaderWidget()
            self.reader_widget.load_document(
                self.current_book.file_path,
                self.current_book.current_page
            )
        elif self.current_book.format in ['PDF', 'MOBI']:
            self.reader_widget = PDFReaderWidget()
            self.reader_widget.load_document(
                self.current_book.file_path,
                self.current_book.current_page
            )
        
        if self.reader_widget:
            self.reader_stack.add_named(self.reader_widget, "reader")
            self.reader_stack.set_visible_child_name("reader")
            self.set_title(self.current_book.title)
    
    def _prev_page(self):
        """Navigate to previous page"""
        if self.reader_widget:
            if isinstance(self.reader_widget, PDFReaderWidget):
                self.reader_widget.prev_page()
                self._update_position()
            elif isinstance(self.reader_widget, EPUBReaderWidget):
                self.reader_widget.prev_chapter()
                self._update_position()
    
    def _next_page(self):
        """Navigate to next page"""
        if self.reader_widget:
            if isinstance(self.reader_widget, PDFReaderWidget):
                self.reader_widget.next_page()
                self._update_position()
            elif isinstance(self.reader_widget, EPUBReaderWidget):
                self.reader_widget.next_chapter()
                self._update_position()
    
    def _update_position(self):
        """Update reading position in database"""
        if self.current_book and self.reader_widget:
            if isinstance(self.reader_widget, PDFReaderWidget):
                page = self.reader_widget.current_page
            elif isinstance(self.reader_widget, EPUBReaderWidget):
                page = self.reader_widget.current_chapter
            else:
                return
            
            self.db.update_book_position(self.current_book.id, page)
            self.current_book.current_page = page
    
    def _show_library(self):
        """Return to library view"""
        self.reader_stack.set_visible_child_name("welcome")
        self.set_title("Librum")
        
        if self.current_book:
            self._update_position()
            self.current_book = None
        
        self.library_view.refresh()


# ==================== APPLICATION ====================

class LibrumApplication(Adw.Application):
    """Main application class"""
    
    def __init__(self):
        super().__init__(
            application_id="com.github.librum",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )
    
    def do_activate(self):
        """Application activation"""
        win = self.props.active_window
        if not win:
            win = LibrumWindow(self)
        win.present()


# ==================== MAIN ====================

def main():
    """Application entry point"""
    app = LibrumApplication()
    return app.run(None)


if __name__ == "__main__":
    main()
