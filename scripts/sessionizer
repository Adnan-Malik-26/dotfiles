#!/usr/bin/env bash
# =============================================================================
# sessionizer — fast tmux session switcher/creator
# Deps: tmux, fzf, fd; optional: git, tree
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# CONFIG — two types of dir entries:
#   SESSIONIZER_SCAN_DIRS  = recurse into these (e.g. ~/Dev)
#   SESSIONIZER_EXACT_DIRS = add these as-is, no recursion (e.g. ~, ~/.notes)
# Override via ~/.config/sessionizer/config
# ---------------------------------------------------------------------------
SESSIONIZER_SCAN_DIRS=(
  "$HOME/Dev"
  "$HOME/Dev/projects"
  "$HOME/Dev/learning"
  "$HOME/.config"
)
SESSIONIZER_EXACT_DIRS=(
  "$HOME"
  "$HOME/.notes"
)
SESSIONIZER_MAX_DEPTH=2
SESSIONIZER_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/sessionizer"
SESSIONIZER_SCAN_CACHE="${SESSIONIZER_CACHE_DIR}/dirs.cache"
SESSIONIZER_LRU_CACHE="${SESSIONIZER_CACHE_DIR}/lru"
SESSIONIZER_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/sessionizer/config"
SESSIONIZER_PINS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/sessionizer/pins"
SESSIONIZER_CACHE_TTL=300

# ---------------------------------------------------------------------------
# LOAD USER CONFIG
# ---------------------------------------------------------------------------
[[ -f "$SESSIONIZER_CONFIG_FILE" ]] && source "$SESSIONIZER_CONFIG_FILE"

# ---------------------------------------------------------------------------
# COLORS
# ---------------------------------------------------------------------------
C_RESET=$'\033[0m'
C_DIM=$'\033[2m'
C_BOLD=$'\033[1m'
C_GREEN=$'\033[32m'
C_CYAN=$'\033[36m'
C_YELLOW=$'\033[33m'

_nerd_fonts_available() {
  [[ "${NERDFONT:-}" == "1" ]] ||
  [[ "${TERM_PROGRAM:-}" == "kitty" ]] ||
  [[ -n "${KITTY_WINDOW_ID:-}" ]]
}

if _nerd_fonts_available; then
  ICON_DIR=" "
  ICON_GIT=" "
  ICON_TMUX=" "
  ICON_PIN=" "
  ICON_HOME="󰋜 "
else
  ICON_DIR="[d] "
  ICON_GIT="[g] "
  ICON_TMUX="[t] "
  ICON_PIN="[*] "
  ICON_HOME="[H] "
fi

# ---------------------------------------------------------------------------
# ARGUMENT PARSING
# ---------------------------------------------------------------------------
open_nvim=false
selected=""
_emit_list=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --nvim)             open_nvim=true; shift ;;
    --depth)            SESSIONIZER_MAX_DEPTH="${2:?--depth requires a value}"; shift 2 ;;
    --preview)          _do_preview=true; _preview_path="${2:-}"; shift 2 ;;
    --list)             _emit_list=true; shift ;;
    --invalidate-cache|--refresh)
                        rm -f "$SESSIONIZER_SCAN_CACHE"
                        printf "sessionizer: scan cache cleared\n"; exit 0 ;;
    --path)             selected="${2:?--path requires an argument}"; shift 2 ;;
    *)                  selected="$1"; shift ;;
  esac
done

# ---------------------------------------------------------------------------
# PREVIEW — only place git runs; called per hover not per list entry
# ---------------------------------------------------------------------------
_preview() {
  local path="$1"
  [[ -d "$path" ]] || { printf "not a directory: %s\n" "$path"; return; }

  if git -C "$path" rev-parse --is-inside-work-tree &>/dev/null 2>&1; then
    local branch
    branch="$(git -C "$path" branch --show-current 2>/dev/null || echo "detached")"
    printf "${C_YELLOW}${ICON_GIT}${C_RESET} branch: ${C_BOLD}%s${C_RESET}\n\n" "$branch"
    git -C "$path" status --short 2>/dev/null | head -15
    printf "\n"
  fi

  if command -v tree &>/dev/null; then
    tree -L 2 -a --noreport \
      -I ".git|node_modules|__pycache__|target|dist|build|.venv|venv" \
      --dirsfirst "$path" 2>/dev/null | head -25
  else
    ls -1 --color=always "$path" 2>/dev/null | head -25
  fi
}

if [[ "${_do_preview:-false}" == true ]]; then
  _preview "$_preview_path"
  exit 0
fi

# ---------------------------------------------------------------------------
# DEPENDENCY CHECK
# ---------------------------------------------------------------------------
_check_deps() {
  local missing=()
  command -v tmux &>/dev/null || missing+=("tmux")
  command -v fzf  &>/dev/null || missing+=("fzf")
  command -v fd   &>/dev/null || missing+=("fd")
  if [[ ${#missing[@]} -gt 0 ]]; then
    printf "sessionizer: missing deps: %s\n" "${missing[*]}" >&2; exit 1
  fi
}

# ---------------------------------------------------------------------------
# SESSION NAME SANITIZATION
# ---------------------------------------------------------------------------
_sanitize_name() {
  local name="${1##*/}"
  name="${name//[. ]/-}"
  name="${name//[^a-zA-Z0-9_-]/}"
  printf "%s" "$name"
}

# ---------------------------------------------------------------------------
# DIRECTORY SCANNER — TTL-based cache
#
# Key design decision:
#   SCAN_DIRS  → fd recursion (finds project subdirs)
#   EXACT_DIRS → added directly, never recursed into
#
# This prevents $HOME from spawning thousands of entries and stops
# ~/.antigravity / VSCode extension dirs from polluting the list.
# ---------------------------------------------------------------------------
_scan_dirs() {
  mkdir -p "$SESSIONIZER_CACHE_DIR"

  # Cache hit?
  if [[ -f "$SESSIONIZER_SCAN_CACHE" ]]; then
    local now mtime
    now=$(date +%s)
    mtime=$(stat -c %Y "$SESSIONIZER_SCAN_CACHE" 2>/dev/null ||
            stat -f %m  "$SESSIONIZER_SCAN_CACHE" 2>/dev/null || echo 0)
    if (( now - mtime < SESSIONIZER_CACHE_TTL )); then
      cat "$SESSIONIZER_SCAN_CACHE"
      return
    fi
  fi

  local tmp="${SESSIONIZER_SCAN_CACHE}.tmp"

  {
    # 1. Exact dirs — added as-is (e.g. $HOME, ~/.notes)
    for dir in "${SESSIONIZER_EXACT_DIRS[@]}"; do
      [[ -d "$dir" ]] && printf "%s\n" "$dir"
    done

    # 2. Scanned dirs — fd recurses here to find project roots
    for dir in "${SESSIONIZER_SCAN_DIRS[@]}"; do
      [[ -d "$dir" ]] || continue
      fd . "$dir" \
        --type d \
        --max-depth "$SESSIONIZER_MAX_DEPTH" \
        --exclude ".git" \
        --exclude "node_modules" \
        --exclude "__pycache__" \
        --exclude "target" \
        --exclude "dist" \
        --exclude "build" \
        --exclude ".cache" \
        --exclude ".venv" \
        --exclude "venv" \
        --exclude ".antigravity" \
        2>/dev/null
    done
  } | sort -u | tee "$tmp"

  mv "$tmp" "$SESSIONIZER_SCAN_CACHE"
}

# ---------------------------------------------------------------------------
# LRU CACHE
# ---------------------------------------------------------------------------
_lru_read()   { [[ -f "$SESSIONIZER_LRU_CACHE" ]] && cat "$SESSIONIZER_LRU_CACHE" || true; }
_lru_update() {
  mkdir -p "$SESSIONIZER_CACHE_DIR"
  { printf "%s\n" "$1"; _lru_read; } \
    | awk '!seen[$0]++' | head -50 > "${SESSIONIZER_LRU_CACHE}.tmp"
  mv "${SESSIONIZER_LRU_CACHE}.tmp" "$SESSIONIZER_LRU_CACHE"
}

# ---------------------------------------------------------------------------
# PINNED DIRS
# ---------------------------------------------------------------------------
_pinned_dirs() {
  [[ -f "$SESSIONIZER_PINS_FILE" ]] && grep -v '^\s*#\|^\s*$' "$SESSIONIZER_PINS_FILE" || true
}

# ---------------------------------------------------------------------------
# BUILD FZF LIST
# Priority: pins → LRU → scan results
# NO git calls here — git only in _preview
# ---------------------------------------------------------------------------
_build_list() {
  local sessions pins lru all_dirs
  sessions="$(tmux list-sessions -F "#{session_name}" 2>/dev/null || true)"
  pins="$(_pinned_dirs)"
  lru="$(_lru_read)"

  all_dirs="$(
    {
      [[ -n "$pins" ]] && printf "%s\n" "$pins"
      [[ -n "$lru"  ]] && printf "%s\n" "$lru"
      _scan_dirs
    } | awk 'NF && !seen[$0]++'
  )"

  while IFS= read -r path; do
    [[ -d "$path" ]] || continue
    local name suffix prefix icon display_path
    name="$(_sanitize_name "$path")"
    [[ -z "$name" ]] && continue

    # Active session indicator (no subprocess — grep pre-fetched string)
    if printf "%s\n" "$sessions" | grep -qxF "$name" 2>/dev/null; then
      suffix=" ${C_GREEN}${ICON_TMUX}${C_RESET}"
    else
      suffix=""
    fi

    # Pin indicator
    if [[ -n "$pins" ]] && printf "%s\n" "$pins" | grep -qxF "$path" 2>/dev/null; then
      prefix="${C_YELLOW}${ICON_PIN}${C_RESET}"
    else
      prefix="  "
    fi

    [[ "$path" == "$HOME" ]] && icon="${ICON_HOME}" || icon="${ICON_DIR}"
    display_path="${path/#$HOME/\~}"

    # RAW_PATH<TAB>DISPLAY — fzf shows col 2, {1} gives raw path
    printf "%s\t%s%s%s%-28s %s%s%s%s\n" \
      "$path" \
      "$prefix" "$icon" \
      "${C_BOLD}${C_CYAN}" "$name" \
      "${C_DIM}" "$display_path" \
      "${C_RESET}" "$suffix"
  done <<< "$all_dirs"
}

# ---------------------------------------------------------------------------
# FZF LAUNCHER
# ---------------------------------------------------------------------------
_run_fzf() {
  local preview_cmd="${BASH_SOURCE[0]} --preview {1}"

  local fzf_opts=(
    --ansi
    --no-sort
    --delimiter=$'\t'
    --with-nth=2
    --nth=2
    --prompt="📁 "
    --pointer="❯"
    --marker="✓"
    --border=rounded
    --height=60%
    --reverse
    --info=inline
    --preview="$preview_cmd"
    --preview-window="right:40%:wrap"
    --bind="ctrl-/:toggle-preview"
    --bind="ctrl-d:preview-down"
    --bind="ctrl-u:preview-up"
    --bind="ctrl-r:reload(${BASH_SOURCE[0]} --list)"
    --header=" Enter = switch/create  │  CTRL-/ preview  │  CTRL-R refresh  │  Esc = cancel"
    --color="fg:#cdd6f4,bg:-1,hl:#89b4fa"
    --color="fg+:#cdd6f4,bg+:#313244,hl+:#89dceb"
    --color="border:#585b70,prompt:#cba6f7,pointer:#f5e0dc"
    --color="marker:#a6e3a1,header:#a6adc8,info:#cba6f7"
  )

  if [[ -n "${TMUX:-}" ]] && command -v fzf-tmux &>/dev/null; then
    printf "%s" "$1" | fzf-tmux -p "65%,55%" -- "${fzf_opts[@]}"
  else
    printf "%s" "$1" | fzf "${fzf_opts[@]}"
  fi
}

# ---------------------------------------------------------------------------
# SESSION SWITCH / CREATE
# ---------------------------------------------------------------------------
_switch_or_create() {
  local path="$1"
  local session_name
  session_name="$(_sanitize_name "$path")"

  [[ -z "$session_name" ]] && {
    printf "sessionizer: bad session name for: %s\n" "$path" >&2; exit 1
  }

  _lru_update "$path"

  if ! tmux has-session -t "$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$path"
    [[ "$open_nvim" == true ]] && tmux send-keys -t "${session_name}:1" "nvim" C-m
  fi

  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session_name"
  else
    tmux attach-session -t "$session_name"
  fi
}

# ---------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------
_check_deps

# --list mode: fzf CTRL-R reload
if [[ "$_emit_list" == true ]]; then
  _build_list; exit 0
fi

# Direct path: skip fzf
if [[ -n "$selected" ]]; then
  [[ -d "$selected" ]] || {
    printf "sessionizer: not a directory: %s\n" "$selected" >&2; exit 1
  }
  _switch_or_create "$selected"
  exit 0
fi

# Interactive
list="$(_build_list)"
[[ -z "$list" ]] && { printf "sessionizer: no directories found\n" >&2; exit 1; }

raw="$(_run_fzf "$list")" || exit 0
path="${raw%%$'\t'*}"
[[ -z "$path" ]] && exit 0

_switch_or_create "$path"
exit 0
