#!/bin/bash

# Path to your swww binary
swww_target="$HOME/clones/swww/target/release/swww"

# Find a random wallpaper
RANDOM_FILE=$(find "/home/adnanmalik/walls/catppuccin-walls/" -type f | shuf -n 1)

# Set the wallpaper using swww
"$swww_target" img --transition-type wipe "$RANDOM_FILE"

# Get the filename and send notification
FILENAME=$(basename "$RANDOM_FILE")
notify-send "Random File Selected" "$FILENAME"
echo "$FILENAME"

# Generate Pywal colors
wal -i "$RANDOM_FILE"

# Load generated Pywal colors
source "$HOME/.cache/wal/colors.sh"

# Update Hyprland config with colors
CONFIG_FILE="$HOME/.config/hypr/hyprland.conf"

# Ensure variables are not empty before replacing
[ -n "$background" ] && sed -i "s/^background = .*/background = $background/" "$CONFIG_FILE"
[ -n "$foreground" ] && sed -i "s/^foreground = .*/foreground = $foreground/" "$CONFIG_FILE"
[ -n "$color1" ] && sed -i "s/^border_color = .*/border_color = $color1/" "$CONFIG_FILE"
[ -n "$color2" ] && sed -i "s/^inactive_border_color = .*/inactive_border_color = $color2/" "$CONFIG_FILE"

# Apply changes in Hyprland
hyprctl reload

echo "Hyprland color scheme updated with Pywal colors."

